{"nodes": [{"id": "src_main_resources_db_readme_import_guide", "label": "SJSU Computer Science roadmap import guide", "file_type": "document", "source_file": "src/main/resources/db/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_main_resources_db_readme_cs_bs_roadmap_pdf", "label": "Program Roadmap: Computer Science, BS (SJSU 2026-2027 Academic Catalog PDF)", "file_type": "document", "source_file": "src/main/resources/db/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_main_resources_db_sjsu_cs_2026_2027", "label": "sjsu-cs-2026-2027.sql (roadmap course import)", "file_type": "code", "source_file": "src/main/resources/db/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds 26 roadmap courses; preserves existing codes and is rerunnable without duplicates; runs in one transaction and locks the course table. Descriptions record roadmap placement, not official course descriptions."}, {"id": "src_main_resources_db_sjsu_course_prerequisite_notes", "label": "sjsu-course-prerequisite-notes.sql (prerequisite notes and source metadata import)", "file_type": "code", "source_file": "src/main/resources/db/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_main_resources_db_sjsu_course_prerequisite_codes", "label": "sjsu-course-prerequisite-codes.sql (prerequisite code arrays import)", "file_type": "code", "source_file": "src/main/resources/db/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "21 courses get extracted codes (including alternatives and conditional prerequisites, excluding concurrent workshops and recommendations); 5 have none. Empty arrays do not imply unrestricted enrollment.