t": null, "author": null, "contributor": null}, {"id": "src_main_resources_db_readme_course_category_column", "label": "course.category column (Major / GE / Elective)", "file_type": "concept", "source_file": "src/main/resources/db/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GE when the roadmap description carries a GE Area tag (8 courses), Elective when the course appears only in elective requirement groups (43), otherwise Major (34); MATH 142 and MATH 161A stay Major because they also satisfy the required additional-math choice."}, {"id": "src_main_resources_db_readme_prerequisite_arrays_as_references", "label": "Prerequisite arrays as references, not an all-required checklist", "file_type": "rationale", "source_file": "src/main/resources/db/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arrays include alternatives and conditional prerequisites, so they cannot be treated as a required set; readiness is evaluated by curated rules, and the notes and report hold the full rules."}, {"id": "src_main_resources_db_readme_prerequisite_research_sources", "label": "Prerequisite research sources (SJSU syllabi for 19 courses, provisional secondary sources for 7)", "file_type": "rationale", "source_file": "src/main/resources/db/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The official catalog blocked automated access, so the research used SJSU syllabi and department pages, plus explicitly provisional secondary sources for seven courses."}], "edges": [{"source": "src_main_resources_db_readme_import_guide", "target": "src_main_resources_db_readme_cs_bs_roadmap_pdf", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/main/resources/db/README.md", "source_location": null, "weight": 1.0}, {"sour