review."}, {"id": "docs_api_courseplannerservice", "label": "CoursePlannerService (legacy, removed)", "file_type": "concept", "source_file": "docs/api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removed together with its containsAll helper and the unused Student and Schedule models; eligibility is now evaluated only by EligibilityService."}, {"id": "docs_api_saved_plan_requests", "label": "Saved plan requests (create/get/replace/delete)", "file_type": "concept", "source_file": "docs/api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PUT replaces the entire selection; rejected updates preserve the existing plan; duplicates and over-limit totals return 400; plans are drafts that do not assert eligibility or timetable conflicts; no accounts or ownership."}, {"id": "docs_api_course_plan_tables", "label": "course_plan and course_plan_courses tables", "file_type": "concept", "source_file": "docs/api.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_api_course_planner_rest_api", "target": "docs_api_endpoints", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api.md", "source_location": null, "weight": 1.0}, {"source": "docs_api_course_planner_rest_api", "target": "docs_api_course_requests", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api.md", "source_location": null, "weight": 1.0}, {"source": "docs_api_course_planner_rest_api", "target": "docs_api_prerequisite_frequency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/api.md", "source_location": null, "weight": 1.0}, {"source": "docs_api_course_planner_rest_api", "target": "docs_api_eligibility_requests", "relation": "references", "