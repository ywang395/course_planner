{"nodes": [{"id": "readme_course_planner", "label": "Course Planner (project overview)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spring Boot REST backend plus React frontend for exploring SJSU CS courses, tracking completed classes, ranking most-referenced prerequisites, checking prerequisite readiness, and saving semester plans in PostgreSQL."}, {"id": "readme_run_locally", "label": "Run locally section", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_spring_datasource_env_vars", "label": "SPRING_DATASOURCE_* environment variables", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Override application.properties so real local credentials are never committed; the same variables point backend tests at a separate test database."}, {"id": "readme_hibernate_ddl_auto_update", "label": "Hibernate ddl-auto=update schema creation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tables are created/updated on application startup, so the app must start once before the manual SQL imports; imports are never run automatically at startup."}, {"id": "readme_run_frontend", "label": "Run the frontend section", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_vite_dev_proxy", "label": "Vite /api development proxy", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forwards /api to localhost:8080 so the frontend uses relative URLs without backend CORS changes; the proxy is not part of the production build, so production hosting must route /api to Spring Boot."}, {"id": "readme_completed_class_tracking", "label": "Completed-class tracking (transitive prerequisite coverage)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marking a class counts its prerequisites as completed transitively; because prerequisite lists include alternatives, every listed alternative is covered, not only the one taken. Selection is saved per browser in localStorage (no accounts)."}, {"id": "readme_prerequisite_ranking_panel", "label": "Most-referenced prerequisites ranking panel", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Score remaining/total shows how many not-yet-completed courses still list a class; grouped into Major/GE/Elective sections then by subject. A high rank means most referenced, not required, because lists include alternatives."}, {"id": "readme_off_catalog_prerequisites", "label": "Off-catalog prerequisites (e.g. MATH 19, CMPE 102)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepted as completed codes because students may have completed courses that were not imported; off-catalog variants (ENGL 1AF, MATH 31X) follow the catalog course they extend."}, {"id": "readme_import_course_data", "label": "Import course data section (ordered manual psql imports)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five imports run in order after the app has created tables: the first three load 26 roadmap courses with researched notes, the last two load and sync the normalized 2026-27 catalog, bringing the course table to 85 courses. Still not a complete university catalog."}, {"id": "readme_api_endpoints", "label": "API endpoints table (README)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tests", "label": "Tests section (Vitest frontend, PostgreSQL-backed backend tests)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend tests need no backend; backend tests need a reachable PostgreSQL and create their own fixtures; API tests roll back data but not schema creation or identity-sequence advancement."}, {"id": "readme_limitations", "label": "Limitations (no auth, draft plans, partial eligibility rules)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit eligibility rules cover only 10 courses; saved plans are drafts that check unit limits but not eligibility or timetable conflicts; no authentication or plan ownership, so keep the instance local; completed classes are per browser; plans and eligibility are API-only (createPlan has no UI yet)."}], "edges": [{"source": "readme_course_planner", "target": "readme_run_locally", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_course_planner", "target": "readme_run_frontend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_course_planner", "target": "readme_import_co